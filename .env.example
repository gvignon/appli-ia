# Copiez ce fichier en ".env" et renseignez UNE des cles API ci-dessous
# (inutile de toutes les remplir, sauf pour comparer les fournisseurs).
# Sans cle, l'application fonctionne quand meme : les descriptions des
# schemas restent a saisir manuellement dans l'interface de relecture. Le
# mode "generation IA directe" (ia.html) necessite en revanche une cle.

# Fournisseur a utiliser : "anthropic", "mistral" ou "gemini". Si absent,
# l'appli choisit automatiquement selon la cle presente ci-dessous
# (Anthropic en priorite, puis Mistral, puis Gemini).
IA_PROVIDER=

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Mistral ---
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-medium-latest

# --- Gemini (Google AI Studio -- console.cloud.google.com non requis,
# cle gratuite via aistudio.google.com, aucune carte bancaire necessaire
# pour le niveau gratuit) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

PORT=3000
