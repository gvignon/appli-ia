# Copiez ce fichier en ".env" et renseignez UNE des deux cles API ci-dessous
# (Anthropic OU Mistral -- inutile de remplir les deux, sauf pour comparer).
# Sans cle, l'application fonctionne quand meme : les descriptions des
# schemas restent a saisir manuellement dans l'interface de relecture. Le
# mode "generation IA directe" (ia.html) necessite en revanche une cle.

# Fournisseur a utiliser : "anthropic" ou "mistral". Si absent, l'appli
# choisit automatiquement selon la cle presente ci-dessous (Anthropic en
# priorite si les deux sont renseignees).
IA_PROVIDER=

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Mistral ---
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-medium-latest

PORT=3000
